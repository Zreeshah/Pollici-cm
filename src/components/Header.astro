---
---

<header 
  class="fixed top-0 left-0 right-0 z-40 transition-all duration-300"
  x-data="{ isScrolled: false, mobileMenuOpen: false }"
  x-init="window.addEventListener('scroll', () => { isScrolled = window.scrollY > 50 })"
  :class="{ 
    'bg-white/90 dark:bg-neutral-900/90 backdrop-blur-md shadow-lg': isScrolled,
    'bg-transparent': !isScrolled 
  }"
>
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8" role="navigation" aria-label="Navigazione principale">
    <div class="flex items-center justify-between h-16 lg:h-20">
      <!-- Logo -->
      <div class="flex-shrink-0">
        <a 
          href="/" 
          class="text-2xl font-bold text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors duration-200"
          aria-label="Pollici CM - Pagina principale"
        >
          <span class="serif italic">Pollici</span><span class="text-neutral-700 dark:text-neutral-300">CM</span>
        </a>
      </div>

      <!-- Desktop Navigation -->
      <div class="hidden md:block">
        <div class="flex items-center space-x-8">
          <a 
            href="/" 
            class="text-neutral-800 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 font-medium transition-colors duration-200 italic"
            :class="{ 'text-white hover:text-primary-300': !isScrolled }"
          >
            <em>Home</em>
          </a>
          <a 
            href="/chi-siamo" 
            class="text-neutral-800 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 font-medium transition-colors duration-200 italic"
            :class="{ 'text-white hover:text-primary-300': !isScrolled }"
          >
            <em>Chi Siamo</em>
          </a>
          <a 
            href="#calcolatore" 
            class="text-neutral-800 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 font-medium transition-colors duration-200 italic"
            :class="{ 'text-white hover:text-primary-300': !isScrolled }"
          >
            <em>Calcolatore</em>
          </a>
          <a 
            href="/sitemap" 
            class="text-neutral-800 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 font-medium transition-colors duration-200 italic"
            :class="{ 'text-white hover:text-primary-300': !isScrolled }"
          >
            <em>Tutte le Conversioni</em>
          </a>
        </div>
      </div>

      <!-- Theme Toggle & Mobile Menu Button -->
      <div class="flex items-center space-x-4">
        <!-- Theme Toggle -->
        <button
          @click="darkMode = !darkMode; localStorage.setItem('darkMode', darkMode)"
          class="p-2 rounded-md text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors duration-200"
          aria-label="Cambia tema"
        >
          <svg x-show="!darkMode" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path>
          </svg>
          <svg x-show="darkMode" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path>
          </svg>
        </button>

        <!-- Mobile menu button -->
        <button
          @click="mobileMenuOpen = !mobileMenuOpen"
          class="md:hidden p-2 rounded-md text-neutral-800 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors duration-200"
          :class="{ 'text-white hover:text-primary-300 hover:bg-white/10': !isScrolled }"
          aria-label="Menu di navigazione"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path x-show="!mobileMenuOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            <path x-show="mobileMenuOpen" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div x-show="mobileMenuOpen" x-transition class="md:hidden">
      <div class="px-2 pt-2 pb-3 space-y-1 bg-white dark:bg-neutral-900 rounded-lg mt-2 shadow-lg">
        <a 
          href="/" 
          class="block px-3 py-2 text-neutral-800 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 font-medium transition-colors duration-200 italic"
          @click="mobileMenuOpen = false"
        >
          <em>Home</em>
        </a>
        <a 
          href="/chi-siamo" 
          class="block px-3 py-2 text-neutral-800 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 font-medium transition-colors duration-200 italic"
          @click="mobileMenuOpen = false"
        >
          <em>Chi Siamo</em>
        </a>
        <a 
          href="#calcolatore" 
          class="block px-3 py-2 text-neutral-800 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 font-medium transition-colors duration-200 italic"
          @click="mobileMenuOpen = false"
        >
          <em>Calcolatore</em>
        </a>
        <a 
          href="/sitemap" 
          class="block px-3 py-2 text-neutral-800 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 font-medium transition-colors duration-200 italic"
          @click="mobileMenuOpen = false"
        >
          <em>Tutte le Conversioni</em>
        </a>
      </div>
    </div>
  </nav>
</header>