---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { parseCSV } from '../utils/csvParser';

// Import CSV data
import csvData from '../assets/Inches to CM Data.csv?raw';
const conversions = parseCSV(csvData);

// Group conversions for better organization
const groupedConversions = {
  'Frazioni di Pollice': conversions.filter(c => c.inches < 1),
  'Pollici Interi (1-10)': conversions.filter(c => c.inches >= 1 && c.inches <= 10 && c.inches % 1 === 0),
  'Pollici Decimali (1-10)': conversions.filter(c => c.inches >= 1 && c.inches <= 10 && c.inches % 1 !== 0),
  'Misure Medie (11-50)': conversions.filter(c => c.inches > 10 && c.inches <= 50),
  'Misure Grandi (50+)': conversions.filter(c => c.inches > 50)
};
---

<Layout
  title="Tutte le Conversioni Pollici-Centimetri | Sitemap Completa"
  description="Accedi a tutte le conversioni da pollici a centimetri disponibili. Database completo con oltre 200 conversioni precise e dettagliate."
  keywords="sitemap conversioni pollici, elenco completo pollici cm, tutte conversioni pollici centimetri"
  canonical="https://pollici-in-cm.it/sitemap"
>
  <Header />
  
  <main id="main-content" class="pt-20">
    <!-- Hero Section -->
    <section class="py-16 lg:py-24 bg-gradient-to-br from-primary-50 to-neutral-100 dark:from-neutral-800 dark:to-neutral-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="text-4xl lg:text-5xl font-bold text-neutral-800 dark:text-neutral-200 mb-6 serif">
            <em>Tutte le Conversioni Pollici-Centimetri</em>
          </h1>
          <p class="text-xl text-neutral-600 dark:text-neutral-400 mb-8 italic leading-relaxed">
            <em>Database completo con {conversions.length} conversioni precise da pollici a centimetri</em>
          </p>
          <div class="bg-white dark:bg-neutral-800 rounded-xl p-6 shadow-lg inline-block">
            <p class="text-lg text-neutral-700 dark:text-neutral-300 italic">
              <em>Trova rapidamente la conversione che stai cercando</em>
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Search Section -->
    <section class="py-8 bg-white dark:bg-neutral-800">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-2xl mx-auto">
          <div class="relative">
            <input
              type="text"
              id="search-input"
              placeholder="Cerca una conversione (es. 5.5 pollici)..."
              class="w-full px-4 py-3 text-lg border-2 border-primary-200 dark:border-neutral-600 rounded-lg focus:ring-2 focus:ring-primary-500 focus:border-primary-500 dark:bg-neutral-700 dark:text-neutral-200 transition-all duration-200"
            />
            <svg class="absolute right-3 top-3 w-6 h-6 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- Conversions Grid -->
    <section class="py-16 lg:py-24 bg-neutral-50 dark:bg-neutral-900">
      <div class="container mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-6xl mx-auto space-y-12">
          
          {Object.entries(groupedConversions).map(([groupName, groupConversions]) => (
            <article class="bg-white dark:bg-neutral-800 rounded-2xl p-8 shadow-lg" id={groupName.toLowerCase().replace(/\s+/g, '-')}>
              <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200 mb-6 serif">
                <em>{groupName}</em>
                <span class="text-sm font-normal text-neutral-500 dark:text-neutral-400 ml-2">
                  ({groupConversions.length} conversioni)
                </span>
              </h2>
              
              <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                {groupConversions.map((conversion) => (
                  <a 
                    href={`/${conversion.slug}`}
                    class="conversion-item bg-primary-50 dark:bg-neutral-700 hover:bg-primary-100 dark:hover:bg-neutral-600 p-4 rounded-lg text-center transition-all duration-200 group hover:shadow-md"
                    data-inches={conversion.inches}
                    data-cm={conversion.centimeters}
                  >
                    <div class="text-lg font-bold text-primary-600 dark:text-primary-400 group-hover:text-primary-700 dark:group-hover:text-primary-300 mb-1">
                      {conversion.inches}"
                    </div>
                    <div class="text-sm text-neutral-600 dark:text-neutral-400 italic">
                      <em>{conversion.centimeters} cm</em>
                    </div>
                  </a>
                ))}
              </div>
            </article>
          ))}

        </div>
      </div>
    </section>

  </main>
  
  <Footer />

  <script is:inline>
    // Search functionality
    document.addEventListener('DOMContentLoaded', function() {
      const searchInput = document.getElementById('search-input');
      const conversionItems = document.querySelectorAll('.conversion-item');
      
      searchInput.addEventListener('input', function() {
        const searchTerm = this.value.toLowerCase().trim();
        
        conversionItems.forEach(item => {
          const inches = item.dataset.inches;
          const cm = item.dataset.cm;
          const text = `${inches} pollici ${cm} centimetri cm`;
          
          if (searchTerm === '' || text.toLowerCase().includes(searchTerm)) {
            item.style.display = 'block';
            item.parentElement.style.display = 'grid';
          } else {
            item.style.display = 'none';
          }
        });
        
        // Hide empty groups
        document.querySelectorAll('article').forEach(article => {
          const visibleItems = article.querySelectorAll('.conversion-item[style*="block"], .conversion-item:not([style*="none"])');
          if (visibleItems.length === 0 && searchTerm !== '') {
            article.style.display = 'none';
          } else {
            article.style.display = 'block';
          }
        });
      });
    });
  </script>
</Layout>