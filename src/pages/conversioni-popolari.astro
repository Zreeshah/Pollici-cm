---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { parseCSV } from '../utils/csvParser';
import csvData from '../assets/Inches to CM Data.csv?raw';

const conversions = parseCSV(csvData);
---

<Layout
  title="Tutte le Conversioni Pollici-Centimetri | Conversioni Popolari"
  description="Accedi a tutte le conversioni da pollici a centimetri disponibili. Database completo con conversioni precise e dettagliate."
  keywords="conversioni popolari pollici, elenco completo pollici cm, tutte conversioni pollici centimetri"
  canonical="https://pollici-in-cm.it/conversioni-popolari"
>
  <Header />
  <main class="min-h-screen bg-gradient-to-br from-blue-50 via-white to-indigo-50 dark:from-neutral-900 dark:via-neutral-800 dark:to-neutral-900">
    <!-- Hero Section -->
    <section class="pt-32 pb-16 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="text-4xl lg:text-5xl font-bold text-neutral-800 dark:text-neutral-200 mb-6 serif">
          <em>Conversioni Popolari Pollici-Centimetri</em>
        </h1>
        <p class="text-xl text-neutral-600 dark:text-neutral-400 mb-8 italic leading-relaxed">
          <em>Database completo con {conversions.length} conversioni precise da pollici a centimetri</em>
        </p>
      </div>
    </section>

    <!-- Conversions Grid -->
    <section class="pb-20 px-4">
      <div class="max-w-6xl mx-auto">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
          {conversions.map((conversion) => (
            <a 
              href={`/${conversion.slug}`}
              class="group bg-white dark:bg-neutral-800 rounded-xl p-6 shadow-sm hover:shadow-lg transition-all duration-300 border border-neutral-200 dark:border-neutral-700 hover:border-blue-300 dark:hover:border-blue-600"
            >
              <div class="text-center">
                <div class="text-2xl font-bold text-blue-600 dark:text-blue-400 mb-2 group-hover:scale-105 transition-transform">
                  {conversion.inches}"
                </div>
                <div class="text-sm text-neutral-500 dark:text-neutral-400 mb-3">
                  pollici
                </div>
                <div class="text-lg font-semibold text-neutral-800 dark:text-neutral-200 mb-1">
                  {conversion.cm} cm
                </div>
                <div class="text-xs text-neutral-400 dark:text-neutral-500">
                  = {conversion.mm} mm
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>